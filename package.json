{
  "name": "@clawnify/dns-provider",
  "version": "0.4.0",
  "description": "Detect which DNS provider manages a domain (DNS-over-HTTPS NS lookup + nameserver registry), get per-provider guidance for adding records, and drive Domain Connect discovery + sync-flow URLs. Zero dependencies; runs in Cloudflare Workers, browsers, and Node 18+.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clawnify/dns-provider.git"
  },
  "homepage": "https://github.com/clawnify/dns-provider#readme",
  "bugs": "https://github.com/clawnify/dns-provider/issues",
  "keywords": [
    "dns",
    "doh",
    "nameserver",
    "custom-domain",
    "cname",
    "domain-connect"
  ],
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
